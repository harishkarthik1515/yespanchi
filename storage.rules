rules_version = '2';

// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Images and PDFs uploaded from the admin console. Public to view; only admins can upload or delete.
    match /uploads/{path=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if isAdmin();
    }
  }
}
