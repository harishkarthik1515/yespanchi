# Public site URL used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://yespanchi.com

# ---------------------------------------------------------------------------
# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# Safe to expose; security rules protect the data. Until these are set the site
# serves its built-in content and the console shows a setup notice.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID

# ---------------------------------------------------------------------------
# Firebase service account, SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# (Project settings > Service accounts > Generate new private key; copy client_email and private_key.)
# Used to store form submissions and to publish console edits instantly.
# Keep the private key on one line with \n for line breaks, wrapped in double quotes.
# ---------------------------------------------------------------------------
FIREBASE_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT@YOUR_PROJECT.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="YOUR_PRIVATE_KEY"

# ---------------------------------------------------------------------------
# Secret admin console address: https://<site>/<ADMIN_PATH>
# Use a long random value (at least 12 characters), share it only with admins.
# ---------------------------------------------------------------------------
ADMIN_PATH=YOUR_SECRET_ADMIN_PATH

# ---------------------------------------------------------------------------
# Image/PDF uploads via Cloudinary (free plan, no card needed): cloudinary.com > Dashboard.
# Leave NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME empty to upload to Firebase Storage instead.
# The API secret is SERVER ONLY; uploads are signed for signed-in admins.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
